# Template of the ".env" with the MQTT broker and Redis credentials of
# step_client. Copy it to ".env" (git-ignored) in the directory step_client is
# launched from, or in one of its parent directories. MqttCredential.from_env
# (step_lib) and RedisCredential.from_env (step_redis) read it at start-up; a
# variable already set in the environment (shell, container) takes precedence
# over the value in ".env".

# Host name or IP address of the MQTT broker. Required.
MQTT_URL=broker.example.com

# TCP port of the MQTT broker (1-65535). Required. Usually 8883 with TLS
# (stepBroker.mqttClient.sslEnable true), 1883 without.
MQTT_PORT=8883

# Username for broker authentication. Optional: unset or empty connects
# anonymously.
MQTT_USERNAME=my_user

# Password for broker authentication. Optional; ignored (with a warning) when
# MQTT_USERNAME is not set.
MQTT_PASSWORD=my_secret

# Host name or IP address of the Redis server. Required.
REDIS_URL=redis.example.com

# TCP port of the Redis server (1-65535). Required. Usually 6380 with TLS
# (redis.connection.sslEnable true), 6379 without.
REDIS_PORT=6380

# ACL username. Optional: unset or empty authenticates as the "default" user
# (or not at all when the password is unset or empty too).
REDIS_USERNAME=my_user

# Password. Optional: unset or empty when the server requires no
# authentication.
REDIS_PASSWORD=my_secret
