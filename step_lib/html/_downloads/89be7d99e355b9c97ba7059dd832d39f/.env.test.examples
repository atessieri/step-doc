# Template of the local ".env" for the MQTT integration tests only
# (test/test_integration_mqtt.py). Copy it to ".env" in the project root
# (git-ignored): the tests look for ".env" from the test/ directory upwards, so
# the current directory does not matter. The values are read without changing
# os.environ, and a variable already set in the environment (shell, CI) takes
# precedence over the value in ".env". For the broker credentials of an
# application see .env.mqtt.examples: both sets of variables can live in the
# same ".env".

# Port of the MQTT broker on the host, the <host port> of "podman run -p".
# Required: when unset (and not in the environment) the integration tests are
# skipped.
STEP_LIB_MQTT_TEST_PORT=18830

# Host of the MQTT broker. Optional, defaults to 127.0.0.1.
STEP_LIB_MQTT_TEST_HOST=127.0.0.1
