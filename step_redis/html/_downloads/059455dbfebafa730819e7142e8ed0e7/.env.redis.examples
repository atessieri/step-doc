# Template of the ".env" with the Redis host, port and credentials of an
# application. Copy it to ".env" (git-ignored) in the directory the application
# is launched from (doc/examples for the stream_demo and monitor_demo packages),
# or in one of its parent directories. RedisCredential.from_env reads it at
# start-up; a variable already set in the environment (shell, container) takes
# precedence over the value in ".env".

# Host name or IP address of the Redis server. Required.
REDIS_URL=redis.example.com

# TCP port of the Redis server (1-65535). Required. Usually 6380 with TLS
# (RedisConnection.sslEnable true), 6379 without.
REDIS_PORT=6380

# ACL username. Optional: unset or empty authenticates as the "default" user
# (or not at all when the password is unset or empty too).
REDIS_USERNAME=my_user

# Password. Optional: unset or empty when the server requires no
# authentication.
REDIS_PASSWORD=my_secret
