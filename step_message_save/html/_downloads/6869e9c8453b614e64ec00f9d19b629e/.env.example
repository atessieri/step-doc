# Template of the ".env" with the MQTT broker credentials of
# step_message_save. Copy it to ".env" (git-ignored) in the directory
# step_message_save is launched from, or in one of its parent directories.
# MqttCredential.from_env (step_lib) reads it at start-up; a variable already
# set in the environment (shell, container) takes precedence over the value in
# ".env".

# Host name or IP address of the MQTT broker. Required.
MQTT_URL=broker.example.com

# TCP port of the MQTT broker (1-65535). Required. Usually 8883 with TLS
# (stepBroker.mqttClient.sslEnable true), 1883 without.
MQTT_PORT=8883

# Username for broker authentication. Optional: unset or empty connects
# anonymously.
MQTT_USERNAME=my_user

# Password for broker authentication. Optional; ignored (with a warning) when
# MQTT_USERNAME is not set.
MQTT_PASSWORD=my_secret
